# 复制成 .env 后修改，至少要改 DB_PASSWORD 和 APP_URL
# docker compose 会自动读取同目录下的 .env

# 数据库密码：随便生成一串，例如 openssl rand -hex 24
DB_PASSWORD=change-me-please

# 面板对外地址，必须带协议。用反代并启用了 HTTPS 就写 https://
APP_URL=https://mail.example.com

# 初始管理员账号；只在第一次启动写库时生效，之后请在系统里修改
ADMIN_EMAIL=admin
# 留空则首次启动自动生成随机密码并打印到容器日志（推荐）
ADMIN_PASSWORD=

# 容器端口（只绑 127.0.0.1，公网访问交给你的反向代理）
API_PORT=3000
WEB_PORT=8080

# 镜像版本。默认 latest 跟随 main；生产环境建议钉到具体版本，避免 pull 时被升到没测过的构建
# MAILER_IMAGE=ghcr.io/misakacoo/mailer:v1.1.2
# MAILER_WEB_IMAGE=ghcr.io/misakacoo/mailer-web:v1.1.2
