# 邮件营销系统 · 环境变量模板
# 实际文件由 provision.sh 生成到 /etc/mailer/mailer.env（640 root:mailer）
# 修改后需要 systemctl restart mailer-api mailer-worker

NODE_ENV=production
PORT=3000
# 只监听回环，外部访问一律经 Nginx；直接暴露 3000 会绕过 HTTPS 与限流
HOST=127.0.0.1

# PostgreSQL 走本机 TCP，认证方式 scram-sha-256
DATABASE_URL=postgresql://mailer:CHANGE_ME@127.0.0.1:5432/mailer

# 面板地址。追踪像素、点击跳转、退订链接全部基于这个域名生成
APP_URL=https://mail.example.com
TRACKING_BASE_URL=https://mail.example.com

# 单管理员：邮箱仅作标识，密码只存 bcrypt 哈希
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=

# 会话签名密钥，32 字节 hex（openssl rand -hex 32）
JWT_SECRET=

# SMTP 账号密码的加密密钥，AES-256-GCM，32 字节 hex（openssl rand -hex 32）
# 这个值一旦更换，已保存的发件账号密码全部无法解密，必须重新录入
CRED_KEY=

UPLOAD_DIR=/opt/mailer/shared/uploads
TMP_DIR=/opt/mailer/shared/tmp
LOG_LEVEL=info

# 运维自检用：备份目录与站点证书路径。
# 配了这两项，面板「系统运维」页就能提示"备份多久没跑""证书还剩几天"；
# 留空则跳过对应检查，不会报错。
BACKUP_DIR=/var/backups/mailer
TLS_CERT_PATH=/etc/letsencrypt/live/mail.example.com/cert.pem

# 发送侧默认值，面板里可覆盖
DEFAULT_DAILY_LIMIT=50
DEFAULT_MIN_INTERVAL_SEC=30
